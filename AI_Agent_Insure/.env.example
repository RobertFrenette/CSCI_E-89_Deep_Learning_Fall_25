# Database Configuration
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_USER_PASSWORD
POSTGRES_DB=insurance_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MongoDB Configuration
MONGO_ROOT_USER=YOUR_YOUR_MONGO_ROOT_USER
MONGO_ROOT_PASSWORD=YOUR_MONGO_ROOT_PASSWORD
MONGO_USER=YOUR_MONGO_USER
MONGO_PASSWORD=YOUR_MONGO_USER_PASSWORD
MONGO_DB=insurance_users
MONGO_HOST=mongodb
MONGO_PORT=27017

# Node Environment
NODE_ENV=development

# Application Ports
ADMIN_BACKEND_PORT=3001
ADMIN_FRONTEND_PORT=3000
CLIENT_BACKEND_PORT=8001
CLIENT_FRONTEND_PORT=5000
AI_AGENT_PORT=8000

# JWT Configuration
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
ENVIRONMENT=development

# Ollama Configuration
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1

# ChromaDB Configuration
CHROMADB_HOST=chromadb
CHROMADB_PORT=8002
